generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  PRO
  ADMIN
}

enum Specialty {
  COIFFURE
  ESTHETIQUE
  NAIL_ART
  MASSAGE
  MAQUILLAGE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductCategory {
  SOIN
  MAQUILLAGE
  PARFUM
  ACCESSOIRE
  AUTRE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proProfile    ProProfile?
  appointments  Appointment[]  @relation("ClientAppointments")
  orders        Order[]
  conversations Conversation[] @relation("ClientConversations")
  messages      Message[]      @relation("SentMessages")
}

model ProProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  specialties    Specialty[]
  bio            String?
  city           String
  photoUrl       String?
  siret          String      @unique
  siretVerified  Boolean     @default(false)
  isActive       Boolean     @default(true)
  rating         Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  services         Service[]
  availabilities   Availability[]
  unavailableDates UnavailableDate[]
  appointments     Appointment[]     @relation("ProAppointments")
  products         Product[]
  conversations    Conversation[]
}

model Service {
  id              String     @id @default(cuid())
  proId           String
  pro             ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  name            String
  price           Float
  durationMinutes Int
  description     String?

  appointments Appointment[]
}

model Availability {
  id        String     @id @default(cuid())
  proId     String
  pro       ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
}

model UnavailableDate {
  id        String     @id @default(cuid())
  proId     String
  pro       ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  reason    String?
}

model Appointment {
  id        String            @id @default(cuid())
  // Vide pour une réservation sans compte : les coordonnées sont alors dans guest*
  clientId  String?
  client    User?             @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  guestName  String?
  guestEmail String?
  guestPhone String?
  proId     String
  pro       ProProfile        @relation("ProAppointments", fields: [proId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  date      DateTime          @db.Date
  startTime String
  endTime   String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
}

model Product {
  id          String          @id @default(cuid())
  proId       String
  pro         ProProfile      @relation(fields: [proId], references: [id], onDelete: Cascade)
  name        String
  category    ProductCategory
  price       Float
  description String?
  photoUrl    String?
  stock       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  clientId  String
  client    User        @relation(fields: [clientId], references: [id])
  total     Float
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Float
}

// Messagerie : un fil par couple cliente (avec compte) / pro
model Conversation {
  id        String     @id @default(cuid())
  clientId  String
  client    User       @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  proId     String
  pro       ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  // Mis à jour à chaque message, pour trier les fils
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@unique([clientId, proId])
  @@index([proId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
